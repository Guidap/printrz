{
  "name": "printrz",
  "version": "0.1.2",
  "author": "Sylvain Marty <sylvain@guidap.co>",
  "description": "A bridge used to talk with printers using raw commands (esc/pos 100% compatible)",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js && electron-builder",
    "build:dir": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env NODE_OPTIONS=--openssl-legacy-provider BUILD_TARGET=clean node .electron-vue/build.js",
    "build:web": "cross-env NODE_OPTIONS=--openssl-legacy-provider BUILD_TARGET=web node .electron-vue/build.js",
    "release": "build",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider node .electron-vue/dev-runner.js",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.renderer.config.js",
    "test": "npm run unit",
    "unit": "karma start test/unit/karma.conf.js",
    "rebuild-electron": "electron-rebuild -f -w printer"
  },
  "build": {
    "productName": "Printrz",
    "appId": "com.guidap.printrz",
    "artifactName": "${os}_${arch}_${name}.${ext}",
    "directories": {
      "buildResources": "buildResources",
      "output": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guidap",
        "repo": "printrz",
        "vPrefixedTagName": false
      }
    ],
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {},
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "zip"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        },
        {
          "target": "tar.xz"
        }
      ]
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@grandchef/node-printer": "^0.8.0",
    "@mapbox/node-pre-gyp": "^1.0.11",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "express": "^4.21.0",
    "ip": "^2.0.1",
    "material-icons": "^0.3.1",
    "morgan": "^1.10.0",
    "node-forge": "^1.3.1",
    "vue": "^2.7.16",
    "vue-electron": "^1.0.6",
    "vue-material": "^1.0.0-beta-10.2",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "ajv": "^6.5.0",
    "babel-core": "^6.26.3",
    "babel-eslint": "^8.2.3",
    "babel-loader": "^7.1.4",
    "babel-plugin-istanbul": "^4.1.6",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-stage-0": "^6.24.1",
    "babel-register": "^6.26.0",
    "cfonts": "^2.1.2",
    "chai": "^4.1.2",
    "chalk": "^2.4.1",
    "copy-webpack-plugin": "^4.5.1",
    "cross-env": "^5.1.6",
    "css-loader": "^0.28.11",
    "del": "^3.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^4.19.1",
    "eslint-config-standard": "^11.0.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^2.0.0",
    "eslint-plugin-html": "^4.0.3",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-node": "^6.0.1",
    "eslint-plugin-promise": "^3.8.0",
    "eslint-plugin-standard": "^3.1.0",
    "file-loader": "^1.1.11",
    "html-webpack-plugin": "^3.2.0",
    "inject-loader": "^4.0.1",
    "karma": "^2.0.2",
    "karma-chai": "^0.1.0",
    "karma-coverage": "^1.1.2",
    "karma-electron": "^6.0.0",
    "karma-mocha": "^1.3.0",
    "karma-sourcemap-loader": "^0.3.7",
    "karma-spec-reporter": "^0.0.32",
    "karma-webpack": "^3.0.0",
    "mini-css-extract-plugin": "0.4.0",
    "mocha": "^5.2.0",
    "multispinner": "^0.2.1",
    "node-loader": "^0.6.0",
    "sass": "^1.99.0",
    "sass-loader": "^7.0.3",
    "style-loader": "^0.21.0",
    "terser-webpack-plugin": "^4.2.3",
    "url-loader": "^1.0.1",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^15.2.4",
    "vue-style-loader": "^4.1.0",
    "vue-template-compiler": "^2.5.16",
    "webpack": "^4.15.1",
    "webpack-cli": "^3.0.8",
    "webpack-dev-server": "^3.1.4",
    "webpack-hot-middleware": "^2.22.2",
    "webpack-merge": "^4.1.3"
  }
}
